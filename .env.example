APP_ENV=local
APP_NAME=ai-stock-api
APP_VERSION=0.5.0
DATABASE_URL=postgresql+psycopg://ai_stock:ai_stock@localhost:5432/ai_stock
# 本地開發專用 placeholder，請替換成自己的 UUID；LOCAL_MODE=true 時缺值會阻擋啟動
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
LOCAL_MODE=true
REQUEST_ID_HEADER=X-Request-Id
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3100,http://127.0.0.1:3100

# Quote provider switch. V0.5 接受值：
#   shioaji_demo  → 永豐金 Shioaji demo 即時行情（runtime；需安裝 `uv sync --extra shioaji_demo`）
#   in_memory     → 測試 / CI 用 InMemoryQuoteProvider，不需 SHIOAJI_* env
# 任何其他值會在啟動時失敗並列出已知值清單。
QUOTE_PROVIDER=shioaji_demo

# 下列 SHIOAJI_* env 僅在 QUOTE_PROVIDER=shioaji_demo 時讀取；切到 in_memory 留空即可。
# Shioaji 帳號 API key / secret（私密，禁止 commit）。
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
# Demo 訂閱上限；Shioaji free / demo 等級實測為 5 檔。
SHIOAJI_MAX_SUBSCRIPTIONS=5
# 是否走 Shioaji simulation 模式（無真實下單）。
SHIOAJI_SIMULATION=false
# 逗號分隔的 demo 白名單覆寫；空值代表用內建白名單（2330,2317,0050,00878）。
SHIOAJI_DEMO_ALLOWED_SYMBOLS=

# Telegram 通知同步。兩者皆有值時才會送出；任一留空則只保留站內通知。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5

# TWAP slice 背景 worker。啟用時會定期處理到期 slices 與候補價格通知；dev endpoints 仍可手動補跑。
TWAP_WORKER_ENABLED=true
TWAP_WORKER_INTERVAL_SECONDS=1
