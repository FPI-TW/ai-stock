# 正式環境環境變數範本。複製成 .env.prod 後填入真實值，切勿 commit .env.prod。
#   cp .env.prod.example .env.prod

APP_ENV=production
APP_NAME=ai-stock-api
APP_VERSION=0.5.0

# 正式環境必須關閉 LOCAL_MODE：避免掛載 /dev 路由與本地專用旁路。
LOCAL_MODE=false

# --- 資料庫（AWS RDS / Aurora）---
# host 填 RDS 端點或 Aurora 的 writer（cluster）端點；需 TLS 時在結尾加 ?sslmode=require。
DATABASE_URL=postgresql+psycopg://<user>:<password>@<rds-endpoint>:5432/<db_name>

# --- 對外設定 ---
REQUEST_ID_HEADER=X-Request-Id
# 改成真實前端網域，逗號分隔；正式環境不可放 localhost。
CORS_ALLOW_ORIGINS=https://app.your-domain.example
# 前端網址，用來組信件裡的邀請 / 重設密碼絕對連結（結尾不加斜線）。
APP_BASE_URL=https://app.your-domain.example

# 信任的反向代理 IP/CIDR（逗號分隔）。掛 nginx 後，IP 維度限流（login:ip / pwreset:ip）
# 需從 X-Forwarded-For 取真實 client，否則所有請求共用代理 IP → 使用者互相鎖出。
# 預設值＝docker-compose.prod.yml 的 backend 網路固定子網（已用 ipam 釘住）。
# 若改了 compose 子網或前面還有別層代理（ALB/Cloudflare），這裡要一併更新。
# 留空＝視為直連（不解析 XFF）；正式掛代理時務必設定。
TRUSTED_PROXY_IPS=172.28.0.0/16

# --- 必填機密（缺值會 fail-fast 阻擋啟動）---
# 產生方式範例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=change_me_jwt_access_secret
# MFA 加密金鑰（Fernet key）：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change_me_mfa_encryption_key

# --- 行情來源 ---
QUOTE_PROVIDER=shioaji_demo
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_MAX_SUBSCRIPTIONS=5
SHIOAJI_SIMULATION=false
SHIOAJI_DEMO_ALLOWED_SYMBOLS=

# --- AWS SES 寄信（走 SMTP endpoint，四個填齊才真的寄出）---
# 部分填寫會拒絕開機——要嘛四個全填、要嘛四個全空。SES_REGION 建議 ap-southeast-2。
# SES_SMTP_USERNAME / PASSWORD 是 SES SMTP 憑證，不是 IAM access key。
# 沙盒模式下寄件人與收件人都必須是已驗證 identity。
SES_FROM_ADDRESS=
SES_REGION=
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=

# --- Telegram 通知（選填，兩者皆填才送出）---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5

# --- 背景排程（TWAP / idempotency cleanup）---
# 部署架構（issue #53）：背景排程只在 docker-compose.prod.yml 的單一 `worker` service 跑，
# `app` service 已在 compose 用 environment 覆寫成關閉（TWAP_WORKER_ENABLED=false /
# IDEMPOTENCY_CLEANUP_ENABLED=false），避免 app 的多個 uvicorn worker 各起一份排程。
# 下面這個值會被 compose 的 per-service environment 覆寫，僅作非 compose 部署的預設；
# 一般 compose 部署不需更動。
TWAP_WORKER_ENABLED=true
TWAP_WORKER_INTERVAL_SECONDS=1
