# 正式環境環境變數範本。複製成 .env.prod 後填入真實值，切勿 commit .env.prod。
#   cp .env.prod.example .env.prod

APP_ENV=production
APP_NAME=ai-stock-api
APP_VERSION=0.5.0

# 正式環境必須關閉 LOCAL_MODE：避免掛載 /dev 路由與本地專用旁路。
LOCAL_MODE=false

# --- PostgreSQL（compose 內部網路，host 用 service 名 postgres）---
POSTGRES_DB=ai_stock
POSTGRES_USER=ai_stock
# 強密碼，與下方 DATABASE_URL 內容需一致。
POSTGRES_PASSWORD=change_me_strong_db_password
DATABASE_URL=postgresql+psycopg://ai_stock:change_me_strong_db_password@postgres:5432/ai_stock

# --- 對外設定 ---
REQUEST_ID_HEADER=X-Request-Id
# 改成真實前端網域，逗號分隔；正式環境不可放 localhost。
CORS_ALLOW_ORIGINS=https://app.your-domain.example

# --- 必填機密（缺值會 fail-fast 阻擋啟動）---
# 產生方式範例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=change_me_jwt_access_secret
# MFA 加密金鑰（Fernet key）：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change_me_mfa_encryption_key

# --- 行情來源 ---
QUOTE_PROVIDER=shioaji_demo
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_MAX_SUBSCRIPTIONS=5
SHIOAJI_SIMULATION=false
SHIOAJI_DEMO_ALLOWED_SYMBOLS=

# --- Telegram 通知（選填，兩者皆填才送出）---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5

# --- TWAP 背景 worker ---
TWAP_WORKER_ENABLED=true
TWAP_WORKER_INTERVAL_SECONDS=1
